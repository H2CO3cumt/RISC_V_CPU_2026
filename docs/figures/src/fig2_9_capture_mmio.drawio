<mxfile host="app.diagrams.net" type="device">
  <diagram name="图2-9 采集引擎与 MMIO 流程图" id="fig2_9">
    <mxGraphModel dx="1420" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="T1" value="采集流程" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#5B31A8;fillColor=#FCFAFF;strokeColor=#B39DDB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="620" height="1250" as="geometry" /></mxCell>
        <mxCell id="T2" value="寄存器映射与通道" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#1F5E9E;fillColor=#FAFCFE;strokeColor=#7FA8CF;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="700" y="30" width="680" height="1250" as="geometry" /></mxCell>

        <mxCell id="n1" value="空闲（复位后）&#10;armed · triggered · done · overflow 全为 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="d2" value="CONTROL.arm ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="240" y="220" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="n3" value="进入 ARMED，按 SAMPLE_DIV 推进采样节拍&#10;armed = 1，等待触发" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="370" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="d4" value="触发条件命中 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="510" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="n5" value="记录触发点&#10;triggered = 1，trigger_index 锁存命中位置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="670" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="n6" value="按通道掩码采样写入缓存&#10;CHANNEL_MASK 选有效通道，深度 2048 样本" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="810" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="d7" value="采够 POST_COUNT ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="950" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="n8" value="done = 1，等待回读&#10;上位机写 READ_INDEX 递增，读 READ_DATA 逐条取回&#10;CAPTURE_COUNT 给出有效样本数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fillColor=#D6C2F5;strokeColor=#6335C6;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="120" y="1110" width="460" height="120" as="geometry" /></mxCell>

        <mxCell id="regs" value="MMIO 字偏移 addr[7:2]&#10;0   CONTROL      写：arm[0] · stop[1] · clear[2]&#10;1   STATUS       读：armed · triggered · done · overflow&#10;2   SAMPLE_DIV   采样使能间隔&#10;3   CHANNEL_MASK 参与保存与显示的通道&#10;4   TRIGGER_MASK 参与触发比较的通道&#10;5   TRIGGER_VALUE 电平触发目标值&#10;6   TRIGGER_RISE 上升沿触发掩码&#10;7   TRIGGER_FALL 下降沿触发掩码&#10;8   PRE_COUNT    触发前保留样本数&#10;9   POST_COUNT   触发后继续采样数&#10;10  TRIGGER_INDEX 读：触发点在数据流中的位置&#10;11  CAPTURE_COUNT 读：实际有效样本数&#10;12  READ_INDEX   写：数据窗口读指针&#10;13  READ_DATA    读：取回一条样本&#10;14  PATTERN_MODE 激励模式&#10;15  PATTERN_DIV  激励分频&#10;16  PATTERN_DATA 激励字节&#10;17  SAMPLE_OUTPUTS 读：输出通道当前值&#10;18  SRC_SEL      采集源：0 = J8 外部，1 = 核内观测点" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Consolas;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fillColor=#FFFFFF;strokeColor=#7FA8CF;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="600" height="380" as="geometry" /></mxCell>

        <mxCell id="src" value="采集源双选（SRC_SEL）&#10;J8 外部八路引脚，或核内观测点八路；&#10;两路经同一采集链路，切换不改流水线" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="520" width="600" height="120" as="geometry" /></mxCell>

        <mxCell id="ovf" value="缓存写满仍未采够&#10;overflow 置位，CAPTURE_COUNT 停在容量值&#10;溢出属合法状态，判据按 count 与容量比较" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFE9D2;strokeColor=#D9822B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="680" width="600" height="120" as="geometry" /></mxCell>

        <mxCell id="badr" value="非法偏移（非字对齐或 addr[7:2] 大于 18）&#10;rsp_error 置位，不产生任何写副作用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="840" width="600" height="110" as="geometry" /></mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2n" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="275" /><mxPoint x="90" y="135" /></Array></mxGeometry></mxCell>
        <mxCell id="e2y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4n" value="否：继续等待" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;horizontal=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="570" /><mxPoint x="90" y="420" /></Array></mxGeometry></mxCell>
        <mxCell id="e4y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="d7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7n" value="否：继续采样" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;horizontal=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d7" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="1010" /><mxPoint x="620" y="860" /></Array></mxGeometry></mxCell>
        <mxCell id="e78" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#5B31A8;strokeColor=#7A4FD0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

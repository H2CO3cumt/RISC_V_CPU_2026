<mxfile host="app.diagrams.net" type="device">
  <diagram name="图2-10 PC端采集与解析流程图" id="fig2_10">
    <mxGraphModel dx="1400" dy="1260" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="T1" value="上位机采集与解析流程" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#3F3F3F;fillColor=#FBFBFB;strokeColor=#ABABAB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="620" height="1180" as="geometry" /></mxCell>
        <mxCell id="T2" value="协议与判据" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#5B31A8;fillColor=#FCFAFF;strokeColor=#B39DDB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="700" y="30" width="660" height="1180" as="geometry" /></mxCell>

        <mxCell id="n1" value="打开串口，等待板卡提示&#10;115200 8N1，超时上限由命令行给出" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="d2" value="收到 LA_READY ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="245" y="230" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="n3" value="组帧并发送报文&#10;按模式与采集源选 13 或 16 字节&#10;末字节为前面各字节的 XOR 校验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="390" width="460" height="110" as="geometry" /></mxCell>
        <mxCell id="n4" value="等待 LA_DONE，解析 Raw 头&#10;取出 count · trigger 与十六进制样本行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="540" width="460" height="100" as="geometry" /></mxCell>
        <mxCell id="n5" value="拆出八通道采样序列&#10;每个字节对应一拍，bit n 即通道 n&#10;得到 N 点 × 8 通道" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="680" width="460" height="110" as="geometry" /></mxCell>
        <mxCell id="n6" value="按「模式 × 采集源」确定解释口径&#10;采集源决定这一窗怎么读，模式只提供窗口与触发预设" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="120" y="830" width="460" height="110" as="geometry" /></mxCell>
        <mxCell id="n7" value="协议解码与仪器读数&#10;UART / SPI 逐位解码；边沿数 · 频率 · 周期中位数 · 抖动 · 占空比" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#EDEDED;strokeColor=#5F5F5F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="980" width="460" height="110" as="geometry" /></mxCell>
        <mxCell id="n8" value="输出波形页 / VCD / 测量报告&#10;单文件 HTML 波形页、VCD 时序与读数报表" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fillColor=#D8EEDA;strokeColor=#2E7D32;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="120" y="1130" width="460" height="90" as="geometry" /></mxCell>

        <mxCell id="p1" value="三种报文长度&#10;0xA5 四模式：13 字节，pre / post 各 1 字节&#10;0xA7 镜像：13 字节，重定义两个字段&#10;0xA8 双源：16 字节，pre / post 各 2 字节&#10;校验：末字节为前面各字节的 XOR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#B39DDB;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="580" height="160" as="geometry" /></mxCell>
        <mxCell id="p2" value="时序纪律&#10;必须等到最后一次 LA_READY 再发下一包；&#10;否则会覆盖固件的 UART 接收单字节邮箱，&#10;表现为丢命令而不是报错" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#B39DDB;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="580" height="150" as="geometry" /></mxCell>
        <mxCell id="p3" value="判据&#10;镜像模式：解出的字节必须逐字节等于上位机发出的那句；&#10;UART / SPI：与激励字节逐位对照；&#10;计数类模式：只要求值有变化，static 要求全等" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#B39DDB;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="460" width="580" height="170" as="geometry" /></mxCell>
        <mxCell id="p4" value="采集源两路&#10;J8 外部八路引脚，或核内观测点八路；&#10;两路共用同一采集链路与同一套解析接口，&#10;切换只改解释口径，不改流水线与 Core 端口" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#B39DDB;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="660" width="580" height="170" as="geometry" /></mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2n" value="否：继续等待（静默视为已就绪）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;horizontal=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#3F3F3F;strokeColor=#5F5F5F;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="290" /><mxPoint x="90" y="140" /></Array></mxGeometry></mxCell>
        <mxCell id="e2y" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontFamily=Microsoft YaHei;fontColor=#3F3F3F;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5F5F5F;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

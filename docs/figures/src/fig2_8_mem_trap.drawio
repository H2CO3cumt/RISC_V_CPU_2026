<mxfile host="app.diagrams.net" type="device">
  <diagram name="图2-8 访存与异常提交流程图" id="fig2_8">
    <mxGraphModel dx="1420" dy="1240" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="T1" value="访存级（MEM）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#B5641A;fillColor=#FFFCF8;strokeColor=#E0A458;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="700" height="1170" as="geometry" /></mxCell>
        <mxCell id="T2" value="退休边界（WB）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Microsoft YaHei;fontStyle=1;fontColor=#5B31A8;fillColor=#FCFAFF;strokeColor=#B39DDB;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="790" y="30" width="580" height="1170" as="geometry" /></mxCell>

        <mxCell id="n1" value="访存级输入&#10;exmem_access · funct3 · store_data&#10;地址 · d_rsp_valid · d_rsp_error" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFE9D2;strokeColor=#D9822B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="90" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="n2" value="地址与数据装配（访存单元）&#10;load_data · store_wdata · store_wstrb · misaligned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fillColor=#FFE9D2;strokeColor=#D9822B;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="110" y="220" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="d3" value="地址未对齐 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#C86F17;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="350" width="220" height="120" as="geometry" /></mxCell>

        <mxCell id="n3a" value="登记未对齐异常&#10;不发起数据事务&#10;直接记 EXC_MISALIGNED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="230" height="120" as="geometry" /></mxCell>
        <mxCell id="n4" value="发起数据事务&#10;d_req_valid · d_req_addr&#10;d_req_write · d_req_wstrb&#10;等待 d_rsp_valid" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#CCE2F7;strokeColor=#2E6FB7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="270" height="120" as="geometry" /></mxCell>
        <mxCell id="d5" value="响应完成 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#2E6FB7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="425" y="690" width="220" height="120" as="geometry" /></mxCell>

        <mxCell id="n6" value="退休判定&#10;mem_done = 已退休 或 非访存 或 未对齐 或 响应完成&#10;exmem_retired 保证每条指令只退休一次" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFE9D2;strokeColor=#D9822B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="860" width="560" height="110" as="geometry" /></mxCell>
        <mxCell id="n7" value="异常登记&#10;exmem_exc_cause[3:0]，登记不被 trap_take 门控" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="1010" width="560" height="100" as="geometry" /></mxCell>

        <mxCell id="d8" value="退休边界&#10;有异常或中断 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#FFFFFF;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="995" width="250" height="130" as="geometry" /></mxCell>
        <mxCell id="nwb" value="正常写回&#10;寄存器堆提交&#10;无副作用取消" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#D8EEDA;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="1005" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="n9" value="恢复地址与原因&#10;同步异常：mepc = 本条 PC（Store 访问错误用 PC + 4）&#10;中断：mepc = 下一条 PC，且不取消本条指令&#10;mcause：取指未对齐映射回 0&#10;mtval：指令码 / 出错地址 / 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fontStyle=1;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="820" y="770" width="520" height="180" as="geometry" /></mxCell>
        <mxCell id="n10" value="冲刷与重定向&#10;wb_cancel 取消写回副作用 · PC ← mtvec（仅 Direct 模式）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="610" width="520" height="120" as="geometry" /></mxCell>
        <mxCell id="n11" value="CSR 更新&#10;mstatus：MIE → MPIE，并关中断 · 写入 mepc · mcause · mtval" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#E7DBFA;strokeColor=#7A4FD0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="450" width="520" height="120" as="geometry" /></mxCell>
        <mxCell id="n12" value="MRET 返回（另一条路径）&#10;mstatus 由 MPIE 恢复 · PC ← mepc&#10;Trap 与 MRET 同拍时 Trap 优先" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;fillColor=#CCE2F7;strokeColor=#2E6FB7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="520" height="120" as="geometry" /></mxCell>
        <mxCell id="n13" value="Trap 与 MRET 共用 CSR 单元的同一组端口：&#10;trap_enter · trap_return · retire" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Microsoft YaHei;align=center;fillColor=#FFFFFF;strokeColor=#B39DDB;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="520" height="80" as="geometry" /></mxCell>


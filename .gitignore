# Windows and editor files
Thumbs.db
Desktop.ini
*.tmp
*.bak
*~
.vscode/
.idea/

# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/

# Node dependencies for the material generators in scripts/
node_modules/

# HDL simulation outputs
*.vcd
*.fst
*.lxt
*.lxt2
*.vvp
*.wlf
*.wdb

# Generated build directories
build/
out/
dist/
work/

# Temporary workspace files; retain only the official scoring reference images.
# 注意：不要用 "!tmp/pdfs/" 放行整个目录——该目录下同时存在赛事方版权材料的
# 本地副本（指南全文、在线实验手册与 RTL 学习路线的逐页截图），不得进入版本库。
tmp/*
tmp/pdfs/*
!tmp/pdfs/riscv-topic-10.png
!tmp/pdfs/riscv-topic-11.png

# Agent scratch material from earlier sessions (PPT chart cache and validators)
.chart-data-*/
.codex-finalizer/

# PDS shell logs, root-level project descriptor copies
log/
impl.pds
run.log
stdout.log
stderr.log

# PDS implementation stages; every one of them is rebuilt by the project
# pds_recipe.tcl plus scripts/run_*.ps1. The shipped bitstream is archived
# under release/final_submission and release/artifacts instead.
fpga/**/synthesize/
fpga/**/place_route/
fpga/**/route_optimize/
fpga/**/device_map/
fpga/**/generate_bitstream/
fpga/**/report_timing/
fpga/**/compile/
fpga/**/logbackup/
fpga/**/bak/
fpga/**/ip/
*.smsk

# PDS GUI/命令行工作期产物：工程锁与自动日志轮转备份。
# 交付目录同样会被 PDS 直接打开，因此这里必须与 fpga/** 的规则保持一致；
# 轮转出去的旧 pds.log 不参与交付，也不应反复进入版本库。
release/final_submission/logbackup/
release/final_submission/*.pds.lock
release/final_submission/compile/
release/final_submission/device_map/
release/final_submission/generate_bitstream/
release/final_submission/place_route/
release/final_submission/report_timing/
release/final_submission/synthesize/
release/final_submission/results/
*.pds.lock

# PDS + ModelSim 联合仿真的中间产物：在 PDS 里点一次「Behavior Simulation」，
# PDS 会把仿真脚本、ModelSim 编译库和 vsim.wlf 写到 <工程>/sim/behav 下。
# 这些都属于可重建的构建垃圾，与上面的 PDS 阶段目录同等处理；
# scripts/audit_release_package.ps1 也按 .lock/.log 同类排除该目录。
fpga/**/sim/
release/final_submission/sim/

# Development-stage board validation bundle; the distributed form is
# release/MES50HP_board_validation_package.zip
release/board_validation/

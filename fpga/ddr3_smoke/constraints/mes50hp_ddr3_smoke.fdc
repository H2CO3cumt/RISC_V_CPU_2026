### ============ 4. DDR3 PHY 物理约束 ============
# DDR3 PHY PLL0：厂商约束在 158_199；不约束时 PDS 会放到 158_179（那是 pll_1 的位置），导致 IOCLKBUF_0 的专用时钟走不通，报 Place-0084
define_attribute {i:u_dut.I_ipsxb_ddr_top.u_ipsxb_ddrphy_pll_0.PLL.u_pll_e3} {PAP_LOC} {PLL_158_199}
# DDR3 PHY PLL1：对应厂商同一条
define_attribute {i:u_dut.I_ipsxb_ddr_top.u_ipsxb_ddrphy_pll_1.PLL.u_pll_e3} {PAP_LOC} {PLL_158_179}
# ioclk 门控寄存器：厂商约束到该 CLMA 位置
define_attribute {i:u_dut.I_ipsxb_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_150_192:FF3}

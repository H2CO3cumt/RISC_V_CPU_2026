# MES50HP / PGL50H-6IFBG484 / 50 MHz system clock.
create_clock -name {clk_50m} [get_ports {clk_50m}] -period {20.000} -waveform {0.000 10.000}

define_attribute {p:clk_50m} {PAP_IO_DIRECTION} {Input}
define_attribute {p:clk_50m} {PAP_IO_LOC} {P20}
define_attribute {p:clk_50m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_50m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_50m} {PAP_IO_NONE} {TRUE}

# MES50HP LED1 is high-active, pin B2.
define_attribute {p:led1} {PAP_IO_DIRECTION} {Output}
define_attribute {p:led1} {PAP_IO_LOC} {B2}
define_attribute {p:led1} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led1} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led1} {PAP_IO_DRIVE} {8}
define_attribute {p:led1} {PAP_IO_NONE} {TRUE}
define_attribute {p:led1} {PAP_IO_SLEW} {FAST}
